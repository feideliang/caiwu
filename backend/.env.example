# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caiwu
DB_USER=postgres
DB_PASSWORD=

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── IMAP (email attachment data source) ────────────────────
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=finance@example.com
IMAP_PASSWORD=
IMAP_POLL_INTERVAL=300
EMAIL_POLL_HOUR=2
EMAIL_POLL_MINUTE=0

# ── AI (Qwen API) ──────────────────────────────────────────
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60

# ── App ─────────────────────────────────────────────────────
APP_NAME="AI+BI Financial Reporting System"
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["*"]

# ── Data Sync ───────────────────────────────────────────────
SYNC_FULL_INTERVAL_DAYS=1
SYNC_INCREMENTAL_INTERVAL_HOURS=4

# ── Alert ───────────────────────────────────────────────────
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_RETENTION_DAYS=90

# ── Report ──────────────────────────────────────────────────
REPORT_GENERATOR_TIMEOUT_SECONDS=300
REPORT_MAX_RETRIES=3
